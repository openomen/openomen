    Shows needed info like such: CPU, GPU, hwmon drivers, ACPI profiles, hp-wmi status, and kernel version.
    """
    print("OpenOMEN System Information")
    print("=" * 50)
    
    print(f"OpenOMEN Version: {VERSION}")
    print()
    
    # Get kernel version
    try:
        with open("/proc/version", "r") as f:
            kernel_version = f.read().strip()
        print(f"Kernel Version: {kernel_version}")
    except IOError:
        print("Kernel Version: Unable to read /proc/version")
    print()
    
    # Get CPU information
    print("CPU Information:")
    try:
        with open("/proc/cpuinfo", "r") as f:
            for line in f:
                if line.startswith("model name"):
                    cpu_model = line.split(":", 1)[1].strip()
                    print(f"  Model: {cpu_model}")
                    break
            else:
                print("  Model: Unable to detect")
    except IOError:
        print("  Model: Unable to read /proc/cpuinfo")
    
    # CPU core count
    try:
        with open("/proc/cpuinfo", "r") as f:
            core_count = sum(1 for line in f if line.startswith("processor"))
        print(f"  Cores: {core_count}")
    except IOError:
        print("  Cores: Unable to detect")
    print()
    
    # Get GPU information (Multi-GPU Detection Engine)
    print("GPU Information:")
    gpu_detected = False
    
    # Check NVIDIA GPUs
    try:
        result = subprocess.run(
            ["nvidia-smi", "--query-gpu=name,driver_version", "--format=csv,noheader,nounits"],
            capture_output=True, text=True, timeout=5
        )
        if result.returncode == 0 and result.stdout.strip():
            for line in result.stdout.strip().split("\n"):
                nvidia_info = line.split(",")
                if len(nvidia_info) >= 2:
                    print(f"  NVIDIA: {nvidia_info[0].strip()} (Driver: {nvidia_info[1].strip()})")
                    gpu_detected = True
    except (FileNotFoundError, subprocess.TimeoutExpired):
        pass
    
    # Check AMD and Intel GPUs
    try:
        card_dirs = glob.glob("/sys/class/drm/card*/device")
        for card_dir in card_dirs:
            vendor_file = os.path.join(card_dir, "vendor")
            if os.path.exists(vendor_file):
                with open(vendor_file, 'r') as f:
                    vendor = f.read().strip().lower()
                    if vendor == "0x1002":  # AMD vendor ID
                        driver_name = get_amd_driver_info(card_dir)
                        print(f"  AMD: GPU detected (Driver: {driver_name})")
                        gpu_detected = True
                    elif vendor == "0x8086":  # Intel vendor ID
                        print("  Intel: iGPU / Arc Desktop Graphics detected")
                        gpu_detected = True
    except IOError:
        pass
    
    if not gpu_detected:
        print("  No supported GPU detected")
    print()
    
    # hwmon drivers
    print("hwmon Drivers:")
    hwmon_base = "/sys/class/hwmon"
    hwmon_dirs = glob.glob(f"{hwmon_base}/hwmon*")
    
    if hwmon_dirs:
        for hwmon_dir in sorted(hwmon_dirs):
            name_path = os.path.join(hwmon_dir, "name")
            if os.path.exists(name_path):
                try:
                    with open(name_path, 'r') as f:
                        driver_name = f.read().strip()
                    hwmon_num = os.path.basename(hwmon_dir)
                    print(f"  {hwmon_num}: {driver_name}")
                except IOError:
                    continue
    else:
        print("  No hwmon devices found")
    
