        profile_path = os.path.join(RGB_PROFILES_DIR, f"{profile_id}.json")
        if not os.path.exists(profile_path):
            try:
                with open(profile_path, 'w') as f:
                    json.dump(data, f, indent=4)
                _chown_to_real_user(profile_path)
            except IOError as e:
                print(f"Warning: Failed to create default profile: {e}", file=sys.stderr)

def read_rgb_state():
    ensure_rgb_config()
    if os.path.exists(RGB_STATE_PATH):
        try:
            with open(RGB_STATE_PATH, 'r') as f:
                return json.load(f)
        except (IOError, json.JSONDecodeError):
            pass
    return {"enabled": False, "active_profile": "white"}

def write_rgb_state(state):
    ensure_rgb_config()
    try:
        with open(RGB_STATE_PATH, 'w') as f:
            json.dump(state, f, indent=4)
        _chown_to_real_user(RGB_STATE_PATH)
        return True
    except IOError as e:
        print(f"Error: Could not save state file: {e}", file=sys.stderr)
        return False

def list_rgb_profiles():
    ensure_rgb_config()
    profiles = {}
    for path in sorted(glob.glob(os.path.join(RGB_PROFILES_DIR, "*.json"))):
        profile_id = os.path.splitext(os.path.basename(path))[0]
        try:
            with open(path, 'r') as f:
                profiles[profile_id] = json.load(f)
        except (IOError, json.JSONDecodeError) as e:
            print(f"Warning: skipping invalid profile '{profile_id}': {e}", file=sys.stderr)
    return profiles

def load_rgb_profile(profile_id):
    ensure_rgb_config()
    path = os.path.join(RGB_PROFILES_DIR, f"{profile_id}.json")
    if not os.path.exists(path):
        return None
    try:
        with open(path, 'r') as f:
            return json.load(f)
    except (IOError, json.JSONDecodeError) as e:
        print(f"Error: could not read profile '{profile_id}': {e}", file=sys.stderr)
        return None

def detect_rgb_hardware():
    """ Detection of a possible RGB control interface """
    if os.path.isdir("/sys/devices/platform/hp-wmi/rgb_zones"):
        return "Four-Zone Control (rgb_zones)"
    if os.path.exists("/sys/devices/platform/hp-wmi/keyboardleds"):
        return "Legacy/Standard Control (keyboardleds)"
    if os.path.exists("/sys/class/leds/hp_omen::kbd_backlight/zone_colors"):
        return "Kernel Patch Control (zone_colors)"
    return None

def apply_rgb_hardware(profile):
    """ Write colors directly to the detected HP OMEN RGB driver interface. """
    ensure_root()
    
    hw_type = None
    if os.path.isdir("/sys/devices/platform/hp-wmi/rgb_zones"):
        hw_type = "four_zone"
    elif os.path.exists("/sys/devices/platform/hp-wmi/keyboardleds"):
        hw_type = "legacy"
    elif os.path.exists("/sys/class/leds/hp_omen::kbd_backlight/zone_colors"):
        hw_type = "kernel_patch"

    if not hw_type:
        print("Error: No supported RGB hardware interface detected.", file=sys.stderr)
        print("Ensure you have a supported hp-wmi dkms module loaded.", file=sys.stderr)
        return False

    colors = ["000000"] * 4
    if profile:
        if "zones" in profile:
            for i in range(4):
                key = str(i)
                if key in profile["zones"]:
                    color = normalize_hex_color(profile["zones"][key])
                    if color is None:
                        print(f"Error: invalid color '{profile['zones'][key]}' for zone {i} "
                              "(expected #RRGGBB).", file=sys.stderr)
                        return False
                    colors[i] = color
        else:
            fallback_color = "000000"
            animation = profile.get("animation", {})
            if "full" in animation and "0" in animation["full"]:
                fallback_color = normalize_hex_color(animation["full"]["0"])
                if fallback_color is None:
                    print(f"Error: invalid color '{animation['full']['0']}' (expected #RRGGBB).", file=sys.stderr)
                    return False
            colors = [fallback_color] * 4

    try:
        if hw_type == "four_zone":
            for i in range(4):
                zone_file = f"/sys/devices/platform/hp-wmi/rgb_zones/zone{i:02d}"
                if os.path.exists(zone_file):
                    with open(zone_file, "w") as f:
                        f.write(colors[i])
            print(f"Applied zone colors: {', '.join(colors)}")
            return True

        elif hw_type == "legacy":
            concatenated = "".join(colors)
            with open("/sys/devices/platform/hp-wmi/keyboardleds", "w") as f:
                f.write(concatenated)
            print(f"Applied concatenated colors: {concatenated}")
            return True

        elif hw_type == "kernel_patch":
            binary_data = bytearray()
            for col in colors:
                r = int(col[0:2], 16)
                g = int(col[2:4], 16)
                b = int(col[4:6], 16)
                binary_data.extend([r, g, b])
            with open("/sys/class/leds/hp_omen::kbd_backlight/zone_colors", "wb") as f:
                f.write(binary_data)
            print(f"Applied binary zone colors: {binary_data.hex()}")
            return True

    except PermissionError:
        print("Error: Permission denied writing to RGB control paths. Run with sudo.", file=sys.stderr)
        return False
    except IOError as e:
        print(f"Error: Failed to write to RGB interface: {e}", file=sys.stderr)
        return False

    return False

def rgb_status():
    state = read_rgb_state()
    profiles = list_rgb_profiles()
    active = state.get("active_profile")
    enabled = state.get("enabled", False)
    print(f"Keyboard Lights: {'On' if enabled else 'Off'}")
    if active and active in profiles:
        print(f"Current Profile: {profiles[active].get('name', active)}")
    else:
        print("Current Profile: None set")
    print(f"Available Profiles: {', '.join(p.get('name', pid) for pid, p in profiles.items()) or 'None'}")
    return True

def rgb_list():
    profiles = list_rgb_profiles()
    if not profiles:
        print("No RGB profiles found.")
        return True
    print("Available Profiles:")
    for profile_id, data in profiles.items():
        name = data.get("name", profile_id)
        desc = data.get("description", "")
        if desc:
            print(f" - {name}: {desc}")
        else:
            print(f" - {name}")
    return True

def resolve_rgb_profile_id(name):
    """
    Match a user-supplied profile name to an existing profile file id,
    case-insensitively. Only ids of real files in the profiles directory can
    match, so names like '../../foo' never reach the filesystem.
    """
    wanted = name.lower()
    for profile_id in list_rgb_profiles():
        if profile_id.lower() == wanted:
            return profile_id
    return None

def require_rgb_hardware():
    """ Print an error and return False when no RGB interface exists. """
    if detect_rgb_hardware():
        return True
    print("Error: No supported RGB hardware interface detected.", file=sys.stderr)
    print("Ensure you have a supported hp-wmi dkms module loaded.", file=sys.stderr)
    return False

def rgb_set(name):
    """ Select a profile and show it on the keyboard (this also turns the lights on). """
    profile_id = resolve_rgb_profile_id(name)
    profile = load_rgb_profile(profile_id) if profile_id else None
    if profile is None:
        available = ', '.join(list_rgb_profiles().keys())
        print(f"Error: Unknown RGB profile '{name}'.", file=sys.stderr)
        if available:
            print(f"Available profiles: {available}", file=sys.stderr)
        return False
    if not require_rgb_hardware():
        return False

    # Elevate before printing anything, so the re-exec under sudo doesn't print twice.
    ensure_root()
    if not apply_rgb_hardware(profile):
        return False

    # Save state only after the hardware write succeeded.
    state = read_rgb_state()
    state["active_profile"] = profile_id
    state["enabled"] = True
    if not write_rgb_state(state):
        return False
    print(f"RGB Profile set to {profile.get('name', profile_id)} (keyboard lights on)")
    return True

def rgb_power(on):
    if not require_rgb_hardware():
        return False
    ensure_root()
    state = read_rgb_state()
    profile = None
    if on:
        active = state.get("active_profile")
        active = resolve_rgb_profile_id(active) if active else None
        profile = load_rgb_profile(active) if active else None
        if profile is None:
            print("Error: no active profile set — run 'openomen rgb set <name>' first.", file=sys.stderr)
            return False

    # Write the hardware first; only record the new state if that worked.
    if not apply_rgb_hardware(profile):
        return False
    state["enabled"] = on
    if not write_rgb_state(state):
        return False

    if on:
        print(f"Keyboard lights on (profile: {profile.get('name', active)})")
    else:
        print("Keyboard lights off")
    return True

def restore_child_library_path():
    """
    A PyInstaller onefile build sets LD_LIBRARY_PATH to its bundled libraries.
    Child processes (nvidia-smi, sudo, lsmod, patchelf...) would inherit it and
    may load the wrong libssl/libz/libstdc++. Restore the original value for
    them; this process's own loader already read the variable at startup.
    """
    if not getattr(sys, 'frozen', False):
        return
    original = os.environ.get('LD_LIBRARY_PATH_ORIG')
    if original is not None:
        os.environ['LD_LIBRARY_PATH'] = original
    else:
        os.environ.pop('LD_LIBRARY_PATH', None)

def main():
    restore_child_library_path()
    parser = argparse.ArgumentParser(
        description=f"CLI tool for controlling fans, power and RGB on HP OMEN/Victus laptops - V{VERSION} - audixdev",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""
Commands: fan, cpu, gpu, stats, info, power, rgb, doctor, update
Run 'openomen <command> --help' for details.
Run 'openomen <command> -w' to watch in real-time.
"""
    )
    subparsers = parser.add_subparsers(dest='command', help='Available commands')
    fan_parser = subparsers.add_parser('fan', help='Control fan behavior')
