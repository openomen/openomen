# ACPI PROFILES!!
PROFILE_CHOICES_PATH = "/sys/firmware/acpi/platform_profile_choices"
PROFILE_PATH = "/sys/firmware/acpi/platform_profile"

# Combined profiles: name -> (acpi_profile, fan_mode)
COMBINED_PROFILES = {
    "gaming":   ("performance", "max"),
    "balanced": ("balanced",    "auto"),
    "quiet":    ("cool",        "auto"),
}

def read_power_profile():
    """ Try to read the current ACPI power profile """

    if not os.path.exists(PROFILE_PATH):
        print("Error: ACPI platform_profile not found.", file=sys.stderr)
        print("Make sure your kernel supports platform profiles (5.15+).", file=sys.stderr)
        return None

    try:
        with open(PROFILE_PATH, 'r') as f:
            return f.read().strip()
    except IOError as e:
        print(f"Error reading power profile: {e}", file=sys.stderr)
        return None


def set_power_profile(profile):
    """ Attempt to set the ACPI power profile """
    # Validate what the hardware actually supports
    try:
        with open(PROFILE_CHOICES_PATH, 'r') as f:
            valid = f.read().strip().split()
    except IOError as e:
        print(f"Error reading profile choices: {e}", file=sys.stderr)
        return False

    if profile not in valid:
        print(f"Error: '{profile}' is not a valid profile.", file=sys.stderr)
        print(f"Available profiles: {', '.join(valid)}", file=sys.stderr)
        return False

    try:
        with open(PROFILE_PATH, 'w') as f:
            f.write(profile)
        print(f"Power profile set to: {profile}")
        return True
    except PermissionError:
        print("Error: Permission denied. Run with sudo.", file=sys.stderr)
        return False
    except IOError as e:
        print(f"Error writing power profile: {e}", file=sys.stderr)
        return False

def apply_combined_profile(name):
    """ Apply the named combined profile for example = power mode + fan setting """
    name = name.lower()
    if name not in COMBINED_PROFILES:
        print(f"Error: Unknown profile '{name}'.", file=sys.stderr)
        print(f"Available profiles: {', '.join(COMBINED_PROFILES.keys())}", file=sys.stderr)
        return False

    acpi_profile, fan_mode = COMBINED_PROFILES[name]
    success = True

    print(f"Applying '{name}' profile...")

    if not set_power_profile(acpi_profile):
        success = False

    if fan_mode == 'max':
        if not set_fan_boost_mode('enable'):
            success = False
    elif fan_mode == 'auto':
        if not set_fan_boost_mode('disable'):
            success = False

    if success:
        print(f"Profile '{name}' applied successfully.")

    return success

def get_install_path():
    """
    Dynamically chooses the best installation path for openomen
    Looks for existing installations, otherwise falls back to user or system directories
    """
    # If it's in the PATH, use that location
    existing_path = shutil.which("openomen")
    if existing_path:
        return os.path.realpath(existing_path)
    
    # Define standard target directories
    user_bin = os.path.expanduser("~/.local/bin")
    system_bin = "/usr/local/bin"
    
    # Use user-space directory if it exists or is likely intended
    if os.path.exists(user_bin) or not os.access(system_bin, os.W_OK):
        # Create user bin directory if it somehow doesnt exist yet
        os.makedirs(user_bin, exist_ok=True)
        return os.path.join(user_bin, "openomen")
        
    return os.path.join(system_bin, "openomen")

def update_openomen(force=False, verify=True):
    """ 
    Update OpenOMEN to the latest executable. 
    Supports -f/--force for direct URL retrieval bypassing version checks,
    and --no-verify to bypass version validation post-download.
    """
    INSTALL_PATH = get_install_path()
    INSTALL_DIR = os.path.dirname(INSTALL_PATH)
    
    needs_sudo = not os.access(INSTALL_DIR, os.W_OK) if os.path.exists(INSTALL_DIR) else not os.access(os.path.dirname(INSTALL_DIR), os.W_OK)
    ssl_context = ssl._create_unverified_context()

    try:
        print("\nOpenOMEN Updater")
        print(f"Target Path: {INSTALL_PATH}")
        if force:
            print("Mode: FORCED (Direct download from latest release shortcut)")
        if not verify:
            print("Verification: DISABLED")
        print()

        latest_version_clean = None
        download_url = None

        if force:
            # Direct link download without querying GitHub API releases endpoints
            download_url = "https://github.com/openomen/openomen/releases/latest/download/openomen"
            print("Fetching directly from: releases/latest/download/openomen")
        else:
            print("Obtaining latest version info...")
            with urllib.request.urlopen("https://api.github.com/repos/openomen/openomen/releases/latest", context=ssl_context) as response:
                latest_json = json.loads(response.read().decode())
            
            latest_version = latest_json.get("tag_name", "")
            latest_version_clean = latest_version.replace("CLI_", "").replace("v", "").replace("V", "")
            print(f"Latest Version: v{latest_version_clean}")

            # Check local current version
            if os.path.exists(INSTALL_PATH):
                try:
                    result = subprocess.run([INSTALL_PATH], capture_output=True, text=True, timeout=5)
                    current_version_match = None
                    for line in result.stdout.split('\n'):
                        if 'V' in line and any(c.isdigit() for c in line):
                            match = re.search(r'V(\d+\.\d+\.\d+)', line)
                            if match:
                                current_version_match = match.group(1)
                                break
                    
                    if current_version_match:
                        print(f"Current Version: v{current_version_match}")
                        if current_version_match == latest_version_clean:
                            print("\nYou already have the latest version! Use '--force' to reinstall anyway.")
                            return True
                    else:
                        print("Current Version: Unable to detect version")
                except (subprocess.TimeoutExpired, subprocess.CalledProcessError, FileNotFoundError):
                    print("Current Version: Unable to run current binary")
            else:
                print("Current Version: Openomen is not installed.")

            download_url = f"https://github.com/openomen/openomen/releases/download/{latest_version}/openomen"

        print("Downloading latest executable...")
        
        with tempfile.NamedTemporaryFile(mode='wb', delete=False, suffix='_openomen_new') as tmp_file:
            tmp_path = tmp_file.name

        try:
            req = urllib.request.Request(
                download_url,
                headers={'User-Agent': 'Mozilla/5.0'}
            )
            with urllib.request.urlopen(req, context=ssl_context) as response:
                with open(tmp_path, 'wb') as f:
                    f.write(response.read())

            if os.path.getsize(tmp_path) == 0:
                print("ERROR: Downloaded executable size is 0 bytes. Update failed.")
                os.unlink(tmp_path)
                return False

            os.chmod(tmp_path, 0o755)

            if verify:
                print("Verifying binary execution...")
                try:
                    result = subprocess.run([tmp_path], capture_output=True, text=True, timeout=5)
                    downloaded_version_match = None
                    for line in result.stdout.split('\n'):
                        if 'V' in line and any(c.isdigit() for c in line):
                            match = re.search(r'V(\d+\.\d+\.\d+)', line)
                            if match:
                                downloaded_version_match = match.group(1)
                                break
                    
                    if not force and latest_version_clean:
                        if not downloaded_version_match or downloaded_version_match != latest_version_clean:
                            print("ERROR: Downloaded binary version verification failed.")
                            os.unlink(tmp_path)
                            return False
                except (subprocess.TimeoutExpired, subprocess.CalledProcessError):
                    print("ERROR: Downloaded binary execution test failed.")
                    os.unlink(tmp_path)
                    return False
            else:
                print("Skipping post-download validation check (--no-verify set).")

            print(f"Installing binary to '{INSTALL_PATH}'...")
            
            if needs_sudo:
                subprocess.run(['sudo', 'rm', '-f', INSTALL_PATH], check=True)
                subprocess.run(['sudo', 'mv', tmp_path, INSTALL_PATH], check=True)
            else:
                if os.path.exists(INSTALL_PATH):
                    os.remove(INSTALL_PATH)
                shutil.move(tmp_path, INSTALL_PATH)
            
            print("\nSuccessfully updated OpenOMEN to the latest binary release!")
            return True

        except urllib.error.URLError as e:
            print(f"ERROR: Download failed: {e}")
            if os.path.exists(tmp_path):
                os.unlink(tmp_path)
            return False

    except urllib.error.URLError as e:
        print(f"ERROR: Network query failed: {e}")
        return False
    except json.JSONDecodeError as e:
        print(f"ERROR: Failed to parse GitHub API response: {e}")
        return False
    except KeyboardInterrupt:
        print("\nUpdate process interrupted by user.")
        return False
    except Exception as e:
        print(f"ERROR: Unexpected update failure: {e}")
        return False

def run_doctor():
    """ Run hardware compatibility checks """

    print(f"OpenOMEN {VERSION} — Hardware Compatibility Check\n")

    passed = 0
    failed = 0

    print("─── Kernel & Drivers ─────────────────")

    # Check hp-wmi module
    hp_wmi_found = False
    try:
        with open("/proc/modules", "r") as f:
            modules = f.read()
            if "hp_wmi" in modules:
                print("[✓] hp-wmi kernel module loaded")
                passed += 1
                hp_wmi_found = True
            else:
                print("[✗] hp-wmi kernel module not loaded")
                failed += 1
    except IOError:
        # Fallback to lsmod if /proc/modules is unreadable
        try:
            result = subprocess.run(["lsmod"], capture_output=True, text=True, timeout=5)
            if "hp_wmi" in result.stdout:
                print("[✓] hp-wmi kernel module loaded")
                passed += 1
                hp_wmi_found = True
            else:
                print("[✗] hp-wmi kernel module not loaded")
                failed += 1
        except (subprocess.TimeoutExpired, FileNotFoundError):
            print("[✗] hp-wmi kernel module not loaded")
            failed += 1

    # Check hp_wmi_ec module
    try:
        with open("/proc/modules", "r") as f:
            modules = f.read()
            if "hp_wmi_ec" in modules:
                print("[✓] hp_wmi_ec module loaded")
                passed += 1
            else:
                print("[✗] hp_wmi_ec module not found (some models need this instead)")
                failed += 1
    except IOError:
        try:
            result = subprocess.run(["lsmod"], capture_output=True, text=True, timeout=5)
            if "hp_wmi_ec" in result.stdout:
                print("[✓] hp_wmi_ec module loaded")
                passed += 1
            else:
                print("[✗] hp_wmi_ec module not found (some models need this instead)")
                failed += 1
        except (subprocess.TimeoutExpired, FileNotFoundError):
            print("[✗] hp_wmi_ec module not found (some models need this instead)")
            failed += 1

    print("\n─── Fan Control ──────────────────────")

    hwmon_path = find_hwmon_path()
    if hwmon_path:
        print(f"[✓] pwm1_enable found at {hwmon_path}")
        passed += 1

        # Check if pwm1_enable is writable
        pwm_enable_path = os.path.join(hwmon_path, "pwm1_enable")
        if os.access(pwm_enable_path, os.W_OK):
            print("[✓] pwm1_enable is writable")
            passed += 1
        else:
            print("[✗] pwm1_enable not writable (sudo required for fan control)")
            failed += 1

        # Check fan1_input
        fan1_path = os.path.join(hwmon_path, "fan1_input")
        if os.path.exists(fan1_path) and os.access(fan1_path, os.R_OK):
            try:
                with open(fan1_path, 'r') as f:
                    fan1_rpm = int(f.read().strip())
                print(f"[✓] fan1_input readable — {fan1_rpm} RPM")
                passed += 1
            except (IOError, ValueError):
                print("[✗] fan1_input not readable (permission denied or invalid data)")
                failed += 1
        else:
            print("[✗] fan1_input not found")
            failed += 1

        # Check fan2_input
        fan2_path = os.path.join(hwmon_path, "fan2_input")
        if os.path.exists(fan2_path) and os.access(fan2_path, os.R_OK):
            try:
                with open(fan2_path, 'r') as f:
                    fan2_rpm = int(f.read().strip())
                print(f"[✓] fan2_input readable — {fan2_rpm} RPM")
                passed += 1
            except (IOError, ValueError):
                print("[✗] fan2_input not readable (permission denied or invalid data)")
                failed += 1
        else:
            print("[✗] fan2_input not found — single fan model or unsupported")
            failed += 1
    else:
        print("[✗] pwm1_enable not found (hp-wmi hwmon device unavailable)")
        failed += 4 # All fan control checks fail

    print("\n─── Thermal Sensors ──────────────────")
    
    # CPU temperature check
    cpu_temp_found = False
    cpu_driver = None
    cpu_temp_value = None
    
    hwmon_base = "/sys/class/hwmon"
    hwmon_dirs = glob.glob(f"{hwmon_base}/hwmon*")
    
    CPU_DRIVER_PRIORITY = [
        "coretemp", "k10temp", "zenpower", "hp-wmi", "acpitz",
    ]

    def get_hwmon_driver_doctor(hwmon_dir):
        name_path = os.path.join(hwmon_dir, "name")
        if os.path.exists(name_path):
            try:
                with open(name_path, 'r') as f:
                    return f.read().strip().lower()
            except IOError:
                pass
        return ""

    def read_hwmon_temps_doctor(hwmon_dir):
        results = []
        for temp_file in sorted(glob.glob(os.path.join(hwmon_dir, "temp*_input"))):
            try:
                with open(temp_file, 'r') as f:
                    temp_celsius = int(f.read().strip()) / 1000.0
                results.append((temp_file, temp_celsius))
            except IOError:
                continue
        return results

    # Build driver map
    hwmon_by_driver = {}
    for hwmon_dir in hwmon_dirs:
        driver = get_hwmon_driver_doctor(hwmon_dir)
        temps = read_hwmon_temps_doctor(hwmon_dir)
        if temps:
            hwmon_by_driver.setdefault(driver, []).append((hwmon_dir, temps))

    # Check in priority order
    for driver in CPU_DRIVER_PRIORITY:
        if driver in hwmon_by_driver:
            for hwmon_dir, temps in hwmon_by_driver[driver]:
                for temp_file, temp_celsius in temps:
                    label_path = temp_file.replace("_input", "_label")
                    raw_label = ""
                    if os.path.exists(label_path):
                        try:
                            with open(label_path, 'r') as lf:
                                raw_label = lf.read().strip().lower()
                        except IOError:
                            pass
                    SKIP_LABEL_KEYWORDS = ["spd", "dram", "dimm", "ram", "mem", "nvme", "hdd", "ssd", "fan"]
                    if any(kw in raw_label for kw in SKIP_LABEL_KEYWORDS):
                        continue
                    cpu_temp_found = True
                    cpu_driver = driver
                    cpu_temp_value = temp_celsius
                    break
                if cpu_temp_found:
                    break
            if cpu_temp_found:
                break

    if cpu_temp_found:
        print(f"[✓] CPU Thermal sensor found (driver: {cpu_driver}) — {cpu_temp_value:.1f}°C")
        passed += 1
    else:
        print("[✗] No CPU thermal sensor detected")
        failed += 1

    print("\n─── Power Profiles ───────────────────")
    
    # Check platform_profile
    if os.path.exists(PROFILE_PATH) and os.access(PROFILE_PATH, os.R_OK):
        try:
            with open(PROFILE_PATH, 'r') as f:
                current_profile = f.read().strip()
            print(f"[✓] ACPI platform_profile available — current: {current_profile}")
            passed += 1
        except IOError:
            print("[✗] ACPI platform_profile not readable")
            failed += 1
    else:
        print("[✗] ACPI platform_profile not available")
        failed += 1
    
    # Check platform_profile_choices
    if os.path.exists(PROFILE_CHOICES_PATH) and os.access(PROFILE_CHOICES_PATH, os.R_OK):
        try:
            with open(PROFILE_CHOICES_PATH, 'r') as f:
                choices = f.read().strip().split()
            print(f"[✓] Available profiles: {', '.join(choices)}")
            passed += 1
        except IOError:
            print("[✗] platform_profile_choices not readable")
            failed += 1
    else:
        print("[✗] platform_profile_choices not available")
        failed += 1

    print("\n─── GPU Stats ────────────────────────")
    
    # Check nvidia-smi
    if shutil.which('nvidia-smi'):
        print("[✓] nvidia-smi available")
        passed += 1
    else:
        print("[✗] nvidia-smi not found — install nvidia-utils for NVIDIA GPU stats")
        failed += 1

    # Check AMD / Intel DRM hwmon
    drm_hwmon_found = False
    card_dirs = glob.glob("/sys/class/drm/card*/device")
    for card_dir in card_dirs:
        vendor_file = os.path.join(card_dir, "vendor")
        if os.path.exists(vendor_file):
            try:
                with open(vendor_file, 'r') as vf:
                    v_id = vf.read().strip().lower()
                    if v_id == "0x1002":
                        driver_name = get_amd_driver_info(card_dir)
                        print(f"[✓] AMD GPU hwmon found (Driver: {driver_name})")
                        passed += 1
                        drm_hwmon_found = True
                    elif v_id == "0x8086":
                        print("[✓] Intel Graphics (iGPU/Arc) detected")
                        passed += 1
                        drm_hwmon_found = True
            except IOError:
                pass

    if not drm_hwmon_found and not shutil.which('nvidia-smi'):
        print("[✗] No GPU hwmon or tools found — no GPU stats available")
        failed += 1

    print("\n─── Battery ──────────────────────────")
    
    # Check for THE battery
    battery_paths = glob.glob("/sys/class/power_supply/BAT*")
    if battery_paths:
        battery_name = os.path.basename(battery_paths[0])
        print(f"[✓] Battery found: {battery_name}")
        passed += 1

        # Check for charge_control_end_threshold
        charge_control_path = os.path.join(battery_paths[0], "charge_control_end_threshold")
        if os.path.exists(charge_control_path) and os.access(charge_control_path, os.R_OK):
            try:
                with open(charge_control_path, 'r') as f:
                    threshold = f.read().strip()
                print(f"[✓] charge_control_end_threshold available — current: {threshold}")
                passed += 1
            except IOError:
                print("[✗] charge_control_end_threshold not readable")
                failed += 1
        else:
            print("[✗] charge_control_end_threshold not found — battery charge limiting unavailable")
            failed += 1
    else:
        print("[✗] Battery not found")
        failed += 2

    print("\n─── RGB Keyboard ──────────────────────")
    rgb_hint = detect_rgb_hardware()
    if rgb_hint:
        print(f"[✓] RGB control interface detected: {rgb_hint}")
        passed += 1
    else:
        print("[✗] No physical RGB control files found (/sys/devices/platform/hp-wmi/rgb_zones, keyboardleds, etc.)")
        failed += 1

    print(f"\nDoctor complete: {passed} passed, {failed} failed.")

