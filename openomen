# ACPI PROFILES!!
PROFILE_CHOICES_PATH = "/sys/firmware/acpi/platform_profile_choices"
PROFILE_PATH = "/sys/firmware/acpi/platform_profile"

# Combined profiles: name -> (acpi_profile, fan_mode)
# Combined profiles: name -> (ACPI profiles in order of preference, fan_mode).
# The first ACPI profile the machine actually offers is used, since boards
# expose different sets (e.g. 'quiet' vs 'cool' vs 'low-power').
COMBINED_PROFILES = {
    "gaming":   (["performance"],               "max"),
    "balanced": (["balanced"],                  "auto"),
    "quiet":    (["quiet", "low-power", "cool"], "auto"),
}

def read_power_profile_choices():
    """ Return the list of ACPI profiles this machine supports, or None if unreadable. """
    try:
        with open(PROFILE_CHOICES_PATH, 'r') as f:
            return f.read().strip().split()
    except IOError as e:
        print(f"Error reading profile choices: {e}", file=sys.stderr)
        print("Make sure your kernel supports platform profiles (5.15+).", file=sys.stderr)
        return None

def read_power_profile():
    """ Try to read the current ACPI power profile """

    if not os.path.exists(PROFILE_PATH):
        print("Error: ACPI platform_profile not found.", file=sys.stderr)
        print("Make sure your kernel supports platform profiles (5.15+).", file=sys.stderr)
        return None

    try:
        with open(PROFILE_PATH, 'r') as f:
            return f.read().strip()
    except IOError as e:
        print(f"Error reading power profile: {e}", file=sys.stderr)
        return None


def set_power_profile(profile):
    """ Attempt to set the ACPI power profile """
    # Validate what the hardware actually supports
    valid = read_power_profile_choices()
    if valid is None:
        return False

    profile = profile.lower()
    if profile not in valid:
        print(f"Error: '{profile}' is not a valid profile.", file=sys.stderr)
        print(f"Available profiles: {', '.join(valid)}", file=sys.stderr)
        return False

    # Only ask for root once the profile name is known to be valid.
    ensure_root()

    try:
        with open(PROFILE_PATH, 'w') as f:
            f.write(profile)
        print(f"Power profile set to: {profile}")
        return True
    except PermissionError:
        print("Error: Permission denied. Run with sudo.", file=sys.stderr)
        return False
    except IOError as e:
        print(f"Error writing power profile: {e}", file=sys.stderr)
        return False

def apply_combined_profile(name):
    """ Apply the named combined profile for example = power mode + fan setting """
    name = name.lower()
    if name not in COMBINED_PROFILES:
        print(f"Error: Unknown profile '{name}'.", file=sys.stderr)
        print(f"Available profiles: {', '.join(COMBINED_PROFILES.keys())}", file=sys.stderr)
        return False

    preferred, fan_mode = COMBINED_PROFILES[name]

    # Validate everything before asking for root or touching hardware.
    choices = read_power_profile_choices()
    if choices is None:
        return False
    acpi_profile = next((p for p in preferred if p in choices), None)
    if acpi_profile is None:
        print(f"Error: this machine offers none of {', '.join(preferred)} "
              f"for the '{name}' profile.", file=sys.stderr)
        print(f"Available ACPI profiles: {', '.join(choices)}", file=sys.stderr)
        return False
    if not find_hwmon_path():
        print("Error: Could not find hp-wmi hwmon device for fan control.", file=sys.stderr)
        print("Make sure the hp-wmi kernel module is loaded.", file=sys.stderr)
        return False

    ensure_root()
    print(f"Applying '{name}' profile...")

    # Stop on the first failure so a profile is never left half-applied
    # (for example fans on max without the performance power profile).
    if not set_power_profile(acpi_profile):
        print(f"Profile '{name}' was not applied; fan mode left unchanged.", file=sys.stderr)
        return False

    if not set_fan_boost_mode('enable' if fan_mode == 'max' else 'disable'):
        print(f"Profile '{name}' only partly applied: power profile is '{acpi_profile}', "
              "but the fan mode could not be set.", file=sys.stderr)
        return False

    print(f"Profile '{name}' applied successfully.")
    return True

def is_nixos():
    """ Detect whether we're running on NixOS. """
    if os.path.exists("/etc/NIXOS"):
        return True
    try:
        with open("/etc/os-release", "r") as f:
            content = f.read()
        return re.search(r'^ID=nixos\s*$', content, re.MULTILINE) is not None
    except IOError:
        return False


def find_nix_dynamic_linker():
    """
    NixOS has no /lib64/ld-linux-x86-64.so.2, so a generic prebuilt Linux
    binary can't be exec'd as-is (the kernel returns ENOENT for the missing
    interpreter, which looks exactly like "file not found").

    We find a *working* interpreter + lib directory by asking patchelf what
    interpreter an existing, already-working dynamic binary on this system
    uses (NixOS binaries are still dynamically linked, just against an
    interpreter that lives in /nix/store/.../glibc-.../lib/).
    """
    patchelf = shutil.which("patchelf")
    if not patchelf:
        return None, None

    candidates = [
        "/run/current-system/sw/bin/bash",
        "/run/current-system/sw/bin/sh",
        shutil.which("bash"),
        shutil.which("sh"),
    ]
    for candidate in candidates:
        if not candidate or not os.path.exists(candidate):
            continue
        try:
            result = subprocess.run(
                [patchelf, "--print-interpreter", candidate],
                capture_output=True, text=True, timeout=5
            )
            if result.returncode == 0 and result.stdout.strip():
                interpreter = result.stdout.strip()
                lib_dir = os.path.dirname(interpreter)
                return interpreter, lib_dir
        except (subprocess.TimeoutExpired, FileNotFoundError):
            continue
    return None, None


def find_nix_ld_loader():
    """
    If nix-ld is installed/enabled (programs.nix-ld.enable = true;), it
    exposes a working dynamic linker we can invoke the downloaded binary
    through directly, without needing to patch the file at all.
    """
    nix_ld = os.environ.get("NIX_LD")
    if nix_ld and os.path.exists(nix_ld):
        return nix_ld
    for candidate in glob.glob("/run/current-system/sw/share/nix-ld/lib/ld*.so*"):
        if os.path.exists(candidate):
            return candidate
    return None


def patch_binary_for_nixos(binary_path):
    """
    Patch a generic prebuilt Linux binary's ELF interpreter + rpath so it can
    run on NixOS. Requires `patchelf` on PATH (e.g. `nix-shell -p patchelf`,
    or add patchelf to environment.systemPackages).
    Returns True on success, False if patchelf/interpreter unavailable.
    """
    patchelf = shutil.which("patchelf")
    if not patchelf:
        return False

    interpreter, lib_dir = find_nix_dynamic_linker()
    if not interpreter:
        return False

    try:
        subprocess.run([patchelf, "--set-interpreter", interpreter, binary_path],
                        check=True, timeout=10, capture_output=True)
        subprocess.run([patchelf, "--set-rpath", lib_dir, binary_path],
                        check=True, timeout=10, capture_output=True)
        return True
    except (subprocess.CalledProcessError, subprocess.TimeoutExpired):
        return False


def make_binary_runnable_on_nixos(binary_path):
    """
    Best-effort attempt to make a downloaded prebuilt binary executable on
    NixOS, trying nix-ld first (no modification needed), then patchelf.
    Returns a tuple (runner_prefix, patched) where runner_prefix is a list
    to prepend to the exec argv (empty if the binary can be run directly),
    and patched indicates whether the file itself was modified.
    """
    nix_ld = find_nix_ld_loader()
    if nix_ld:
        print(f"Detected nix-ld ({nix_ld}) — running downloaded binary through it.")
        return [nix_ld], False

    if patch_binary_for_nixos(binary_path):
        print("Patched downloaded binary's ELF interpreter/rpath for NixOS compatibility.")
        return [], True

    print("Warning: could not make the downloaded binary runnable on NixOS.")
    print("Install patchelf (`nix-shell -p patchelf` or add it to")
    print("environment.systemPackages) for automatic patching, or enable")
    print("nix-ld (`programs.nix-ld.enable = true;`) for the smoothest experience.")
    print("See: https://github.com/nix-community/nix-ld")
    return [], False


GITHUB_REPO = "openomen/openomen"
RELEASE_ASSET_NAME = "openomen"
CHECKSUM_ASSET_NAME = "openomen.sha256"
HTTP_TIMEOUT = 30            # seconds per network operation (connect / each read)
MIN_BINARY_SIZE = 1024 * 1024  # a real PyInstaller build is ~10 MB

# CA bundles in common distro locations. The release binary bundles the OpenSSL
# of the machine it was built on (possibly NixOS, whose default cert dir is in
# /nix/store and missing elsewhere), so we load the system bundle explicitly.
CA_BUNDLE_CANDIDATES = [
    "/etc/ssl/certs/ca-certificates.crt",   # Debian, Ubuntu, Arch, NixOS, Gentoo
    "/etc/pki/tls/certs/ca-bundle.crt",     # Fedora, RHEL
    "/etc/ssl/cert.pem",                    # Arch, Alpine, macOS-style
    "/etc/ssl/ca-bundle.pem",               # openSUSE
    "/etc/pki/ca-trust/extracted/pem/tls-ca-bundle.pem",
]


class UpdateError(Exception):
    """ An update failure with a message meant for the user. """


def make_ssl_context():
    """
    Build a certificate-verifying SSL context. Never falls back to an
    unverified one: the downloaded file gets installed (possibly with sudo).
    """
    context = ssl.create_default_context()
    cafile = os.environ.get("SSL_CERT_FILE")
    candidates = [cafile] if cafile else []
    candidates += CA_BUNDLE_CANDIDATES
    for path in candidates:
        if path and os.path.isfile(path):
            try:
                context.load_verify_locations(cafile=path)
                return context
            except (ssl.SSLError, OSError):
                continue
    # No known bundle found; rely on OpenSSL's compiled-in defaults.
    return context


def parse_version(text):
    """ Extract (major, minor, patch) from text like 'CLI_v0.4.4' or 'openomen 0.4.4'. """
    match = re.search(r'(\d+)\.(\d+)\.(\d+)', text or "")
    return tuple(int(x) for x in match.groups()) if match else None


def format_version(version):
    return "v" + ".".join(str(x) for x in version) if version else "unknown"


def http_get(url, ssl_context, accept=None):
    headers = {'User-Agent': f'openomen-updater/{VERSION}'}
    if accept:
        headers['Accept'] = accept
    req = urllib.request.Request(url, headers=headers)
    with urllib.request.urlopen(req, context=ssl_context, timeout=HTTP_TIMEOUT) as response:
        return response.read()


def find_latest_release(ssl_context):
    """
    Return the newest stable CLI release that has an 'openomen' asset, as a dict
    with version, tag, url and checksum info. Looks at the release list rather
    than /releases/latest, so other tag families (e.g. a future GUI) or a release
    without the CLI asset can't be picked by mistake.
    """
    data = json.loads(http_get(
        f"https://api.github.com/repos/{GITHUB_REPO}/releases?per_page=30",
        ssl_context, accept="application/vnd.github+json").decode())
    if not isinstance(data, list):
        raise UpdateError("Unexpected response from the GitHub releases API.")

    best = None
    for release in data:
        if not isinstance(release, dict) or release.get("draft") or release.get("prerelease"):
            continue
        tag = release.get("tag_name", "")
        # Accept 'CLI_v1.2.3', 'v1.2.3' or '1.2.3'; skip anything else ('-rc1', other tools).
        if not re.fullmatch(r'(CLI_)?[vV]?\d+\.\d+\.\d+', tag):
            continue
        assets = {a.get("name"): a for a in release.get("assets", []) if isinstance(a, dict)}
        binary = assets.get(RELEASE_ASSET_NAME)
        if not binary or not binary.get("browser_download_url"):
            continue
        version = parse_version(tag)
        if best is None or version > best["version"]:
            checksum_asset = assets.get(CHECKSUM_ASSET_NAME) or {}
            best = {
                "version": version,
                "tag": tag,
                "url": binary["browser_download_url"],
                # GitHub reports 'sha256:<hex>' for assets uploaded since mid-2025.
                "digest": binary.get("digest"),
                "checksum_url": checksum_asset.get("browser_download_url"),
            }
    if best is None:
        raise UpdateError("No stable OpenOMEN CLI release with an 'openomen' binary was found.")
    return best


def fetch_expected_sha256(digest, checksum_url, ssl_context):
    """ Return the published SHA-256 (lowercase hex), or None if none is published. """
    if digest and digest.lower().startswith("sha256:"):
        return digest.split(":", 1)[1].strip().lower()
    if checksum_url:
        try:
            text = http_get(checksum_url, ssl_context).decode("utf-8", "replace")
        except urllib.error.HTTPError as e:
            if e.code == 404:
                return None
            raise
        match = re.search(r'\b([0-9a-fA-F]{64})\b', text)
        if not match:
            raise UpdateError(f"Published checksum file is malformed: {checksum_url}")
        return match.group(1).lower()
    return None


def download_file(url, dest_path, ssl_context):
    """ Stream url to dest_path. Returns the SHA-256 hex digest of what was written. """
    req = urllib.request.Request(url, headers={'User-Agent': f'openomen-updater/{VERSION}'})
    sha = hashlib.sha256()
    received = 0
    with urllib.request.urlopen(req, context=ssl_context, timeout=HTTP_TIMEOUT) as response:
        expected_len = response.headers.get("Content-Length")
        with open(dest_path, 'wb') as f:
            while True:
                chunk = response.read(256 * 1024)
                if not chunk:
                    break
                f.write(chunk)
                sha.update(chunk)
                received += len(chunk)
    if expected_len and expected_len.isdigit() and received != int(expected_len):
        raise UpdateError(f"Download was cut short ({received} of {expected_len} bytes).")
    return sha.hexdigest()


def check_is_linux_binary(path):
    """ Reject HTML error pages, truncated files and other non-executables. """
    size = os.path.getsize(path)
    with open(path, 'rb') as f:
        magic = f.read(4)
    if magic != b'\x7fELF':
        raise UpdateError("Downloaded file is not a Linux executable (got a web page or a corrupt file?).")
    if size < MIN_BINARY_SIZE:
        raise UpdateError(f"Downloaded binary is suspiciously small ({size} bytes).")


def get_install_path():
    """
    Choose where to install. If openomen is already on PATH, update that path.
    A symlink on PATH is replaced by the new binary; its target is left alone
    (it may be a git checkout of the script, or a read-only store path).
    """
    existing = shutil.which("openomen")
    if existing:
        existing = os.path.abspath(existing)
        if os.path.realpath(existing).startswith("/nix/store/"):
            raise UpdateError(
                f"'{existing}' is managed by Nix. Update it through your Nix configuration instead.")
        return existing

    user_bin = os.path.expanduser("~/.local/bin")
    system_bin = "/usr/local/bin"
    if os.path.isdir(user_bin) or not os.access(system_bin, os.W_OK):
        return os.path.join(user_bin, "openomen")
    return os.path.join(system_bin, "openomen")


def dir_needs_sudo(directory):
    """ True if we can't create files in directory (or its nearest existing parent). """
    probe = directory
    while not os.path.exists(probe):
        parent = os.path.dirname(probe)
        if parent == probe:
            break
        probe = parent
    return not os.access(probe, os.W_OK)


def get_binary_version(path, runner_prefix=None):
    """
    Ask an openomen binary for its version via '--version' (output: 'openomen X.Y.Z').
    Falls back to scraping 'V X.Y.Z' from the help text for binaries older than that
    check. Returns a (major, minor, patch) tuple, or None if it could not be determined.
    Raises OSError / subprocess.TimeoutExpired like subprocess.run.
    """
    cmd = (runner_prefix or []) + [path]
    result = subprocess.run(cmd + ['--version'], capture_output=True, text=True, timeout=10)
    version = parse_version(result.stdout)
    if version:
        return version
    result = subprocess.run(cmd, capture_output=True, text=True, timeout=10)
    match = re.search(r'V(\d+\.\d+\.\d+)', result.stdout)
    return parse_version(match.group(1)) if match else None


def install_binary(src_path, install_path, needs_sudo):
    """
    Put src_path at install_path without ever leaving it missing or half-written:
    copy to a hidden file in the same directory, then rename over the target
    (a rename within one filesystem is atomic).
    """
    install_dir = os.path.dirname(install_path)
    staged = os.path.join(install_dir, ".openomen.new")
    try:
        if needs_sudo:
            subprocess.run(['sudo', 'install', '-Dm755', src_path, staged], check=True)
            subprocess.run(['sudo', 'mv', '-f', staged, install_path], check=True)
        else:
            os.makedirs(install_dir, exist_ok=True)
            shutil.copyfile(src_path, staged)
            os.chmod(staged, 0o755)
            os.replace(staged, install_path)
    finally:
        if os.path.lexists(staged):
            if needs_sudo:
                subprocess.run(['sudo', 'rm', '-f', staged], check=False)
            else:
                with contextlib.suppress(OSError):
                    os.unlink(staged)


def update_openomen(force=False, verify=True):
    """
    Update OpenOMEN to the latest release binary.
    -f/--force skips the version comparison and downloads releases/latest directly;
    --no-verify skips running the downloaded binary to check its version.
    The SHA-256 is always checked when the release publishes one.
    """
    tmp_path = None
    try:
        install_path = get_install_path()
        install_dir = os.path.dirname(install_path)
        needs_sudo = dir_needs_sudo(install_dir)
        ssl_context = make_ssl_context()

        print("\nOpenOMEN Updater")
        print(f"Target Path: {install_path}")
        if os.path.islink(install_path):
            print(f"Note: '{install_path}' is a symlink; it will be replaced by the new binary "
                  f"(the link target '{os.path.realpath(install_path)}' is left untouched).")
        if force:
            print("Mode: FORCED (Direct download from latest release shortcut)")
        if not verify:
            print("Verification: DISABLED")
        print()

        expected_version = None
        if force:
            base = f"https://github.com/{GITHUB_REPO}/releases/latest/download"
            download_url = f"{base}/{RELEASE_ASSET_NAME}"
            digest, checksum_url = None, f"{base}/{CHECKSUM_ASSET_NAME}"
            print(f"Fetching directly from: releases/latest/download/{RELEASE_ASSET_NAME}")
        else:
            print("Obtaining latest version info...")
            release = find_latest_release(ssl_context)
            expected_version = release["version"]
            download_url, digest, checksum_url = release["url"], release["digest"], release["checksum_url"]
            print(f"Latest Version: {format_version(expected_version)}")

            if os.path.exists(install_path):
                try:
                    current = get_binary_version(install_path)
                except (OSError, subprocess.TimeoutExpired):
                    current = None
                    print("Current Version: Unable to run current binary")
                else:
                    print(f"Current Version: {format_version(current) if current else 'Unable to detect version'}")
                if current and current == expected_version:
                    print("\nYou already have the latest version! Use '-f' / '--force' to reinstall anyway.")
                    return True
                if current and current > expected_version:
                    print("\nYour installed version is newer than the latest release; not downgrading.")
                    print("Use '-f' / '--force' to install the latest release anyway.")
                    return True
            else:
                print("Current Version: Openomen is not installed.")

        expected_sha256 = fetch_expected_sha256(digest, checksum_url, ssl_context)

        print("Downloading latest executable...")
        fd, tmp_path = tempfile.mkstemp(prefix="openomen_", suffix=".new")
        os.close(fd)
        actual_sha256 = download_file(download_url, tmp_path, ssl_context)

        check_is_linux_binary(tmp_path)
        if expected_sha256:
            if actual_sha256 != expected_sha256:
                raise UpdateError("Checksum mismatch: the download does not match the published "
                                  "SHA-256. Not installing it.")
            print("Checksum: OK (SHA-256 matches the release)")
        else:
            print("Warning: this release publishes no SHA-256 checksum; only HTTPS protects the download.")

        os.chmod(tmp_path, 0o755)

        nixos = is_nixos()
        runner_prefix = []
        if nixos:
            print("NixOS detected — checking binary compatibility...")
            runner_prefix, _patched = make_binary_runnable_on_nixos(tmp_path)

        if verify:
            print("Verifying binary execution...")
            try:
                downloaded_version = get_binary_version(tmp_path, runner_prefix)
            except subprocess.TimeoutExpired:
                raise UpdateError("Downloaded binary execution test timed out.")
            except OSError as e:
                if nixos:
                    raise UpdateError("Binary still can't execute on NixOS after patching attempt.\n"
                                      "Try: nix-shell -p patchelf, or enable programs.nix-ld.enable = true;")
                raise UpdateError(f"Downloaded binary could not be executed ({e}). "
                                  "If /tmp is mounted noexec, set TMPDIR to another directory.")
            if downloaded_version is None:
                raise UpdateError("Downloaded binary did not report a version.")
            if expected_version and downloaded_version != expected_version:
                raise UpdateError(f"Downloaded binary reports {format_version(downloaded_version)}, "
                                  f"expected {format_version(expected_version)}.")
            print(f"Verified: {format_version(downloaded_version)}")
        else:
            print("Skipping post-download validation check (--no-verify set).")

        print(f"Installing binary to '{install_path}'...")
        install_binary(tmp_path, install_path, needs_sudo)

        print("\nSuccessfully updated OpenOMEN to the latest binary release!")
        return True

    except UpdateError as e:
        print(f"ERROR: {e}")
    except urllib.error.HTTPError as e:
        print(f"ERROR: Server returned HTTP {e.code} for {e.url}")
    except urllib.error.URLError as e:
        if isinstance(e.reason, ssl.SSLCertVerificationError):
            print(f"ERROR: Could not verify GitHub's TLS certificate: {e.reason}")
            print("Your CA certificates may be missing or in an unusual place.")
            print("Install your distro's ca-certificates package, or point SSL_CERT_FILE at a CA bundle.")
        else:
            print(f"ERROR: Network request failed: {e.reason}")
    except (TimeoutError, ConnectionError) as e:
        print(f"ERROR: Network request failed: {e}")
    except json.JSONDecodeError as e:
        print(f"ERROR: Failed to parse GitHub API response: {e}")
    except subprocess.CalledProcessError as e:
        print(f"ERROR: Install command failed: {' '.join(e.cmd)}")
    except KeyboardInterrupt:
        print("\nUpdate process interrupted by user.")
    except OSError as e:
        print(f"ERROR: {e}")
    finally:
        if tmp_path:
            with contextlib.suppress(OSError):
                os.unlink(tmp_path)
    return False

def run_doctor():
    """ Run hardware compatibility checks """

    print(f"OpenOMEN {VERSION} — Hardware Compatibility Check\n")

    passed = 0
    failed = 0

    print("─── Kernel & Drivers ─────────────────")

    # Check hp-wmi module
    hp_wmi_found = False
    try:
        with open("/proc/modules", "r") as f:
            modules = f.read()
            if "hp_wmi" in modules:
                print("[✓] hp-wmi kernel module loaded")
                passed += 1
                hp_wmi_found = True
            else:
                print("[✗] hp-wmi kernel module not loaded")
                failed += 1
    except IOError:
        # Fallback to lsmod if /proc/modules is unreadable
        try:
            result = subprocess.run(["lsmod"], capture_output=True, text=True, timeout=5)
            if "hp_wmi" in result.stdout:
                print("[✓] hp-wmi kernel module loaded")
                passed += 1
                hp_wmi_found = True
            else:
                print("[✗] hp-wmi kernel module not loaded")
                failed += 1
        except (subprocess.TimeoutExpired, FileNotFoundError):
            print("[✗] hp-wmi kernel module not loaded")
            failed += 1

    # Check hp_wmi_ec module
    try:
        with open("/proc/modules", "r") as f:
            modules = f.read()
            if "hp_wmi_ec" in modules:
                print("[✓] hp_wmi_ec module loaded")
                passed += 1
            else:
                print("[✗] hp_wmi_ec module not found (some models need this instead)")
                failed += 1
    except IOError:
        try:
            result = subprocess.run(["lsmod"], capture_output=True, text=True, timeout=5)
            if "hp_wmi_ec" in result.stdout:
                print("[✓] hp_wmi_ec module loaded")
                passed += 1
            else:
                print("[✗] hp_wmi_ec module not found (some models need this instead)")
                failed += 1
        except (subprocess.TimeoutExpired, FileNotFoundError):
            print("[✗] hp_wmi_ec module not found (some models need this instead)")
            failed += 1

    print("\n─── Fan Control ──────────────────────")

    hwmon_path = find_hwmon_path()
    if hwmon_path:
        print(f"[✓] pwm1_enable found at {hwmon_path}")
        passed += 1

        # Check if pwm1_enable is writable
        pwm_enable_path = os.path.join(hwmon_path, "pwm1_enable")
        if os.access(pwm_enable_path, os.W_OK):
            print("[✓] pwm1_enable is writable")
            passed += 1
        else:
            print("[✗] pwm1_enable not writable (sudo required for fan control)")
            failed += 1

        # Check fan1_input
        fan1_path = os.path.join(hwmon_path, "fan1_input")
        if os.path.exists(fan1_path) and os.access(fan1_path, os.R_OK):
            try:
                with open(fan1_path, 'r') as f:
                    fan1_rpm = int(f.read().strip())
                print(f"[✓] fan1_input readable — {fan1_rpm} RPM")
                passed += 1
            except (IOError, ValueError):
                print("[✗] fan1_input not readable (permission denied or invalid data)")
                failed += 1
        else:
            print("[✗] fan1_input not found")
            failed += 1

        # Check fan2_input
        fan2_path = os.path.join(hwmon_path, "fan2_input")
        if os.path.exists(fan2_path) and os.access(fan2_path, os.R_OK):
            try:
                with open(fan2_path, 'r') as f:
                    fan2_rpm = int(f.read().strip())
                print(f"[✓] fan2_input readable — {fan2_rpm} RPM")
                passed += 1
            except (IOError, ValueError):
                print("[✗] fan2_input not readable (permission denied or invalid data)")
                failed += 1
        else:
            print("[✗] fan2_input not found — single fan model or unsupported")
            failed += 1
    else:
        print("[✗] pwm1_enable not found (hp-wmi hwmon device unavailable)")
        failed += 4 # All fan control checks fail

    print("\n─── Thermal Sensors ──────────────────")
    
    # CPU temperature check
    cpu_temp_found = False
    cpu_driver = None
    cpu_temp_value = None
    
    hwmon_base = "/sys/class/hwmon"
    hwmon_dirs = glob.glob(f"{hwmon_base}/hwmon*")
    
    CPU_DRIVER_PRIORITY = [
        "coretemp", "k10temp", "zenpower", "hp-wmi", "acpitz",
    ]

    def get_hwmon_driver_doctor(hwmon_dir):
        name_path = os.path.join(hwmon_dir, "name")
        if os.path.exists(name_path):
            try:
                with open(name_path, 'r') as f:
                    return f.read().strip().lower()
            except IOError:
                pass
        return ""

    def read_hwmon_temps_doctor(hwmon_dir):
        results = []
        for temp_file in sorted(glob.glob(os.path.join(hwmon_dir, "temp*_input"))):
            try:
                with open(temp_file, 'r') as f:
                    temp_celsius = int(f.read().strip()) / 1000.0
                results.append((temp_file, temp_celsius))
            except IOError:
                continue
        return results

    # Build driver map
    hwmon_by_driver = {}
    for hwmon_dir in hwmon_dirs:
        driver = get_hwmon_driver_doctor(hwmon_dir)
        temps = read_hwmon_temps_doctor(hwmon_dir)
        if temps:
            hwmon_by_driver.setdefault(driver, []).append((hwmon_dir, temps))

    # Check in priority order
    for driver in CPU_DRIVER_PRIORITY:
        if driver in hwmon_by_driver:
            for hwmon_dir, temps in hwmon_by_driver[driver]:
                for temp_file, temp_celsius in temps:
                    label_path = temp_file.replace("_input", "_label")
                    raw_label = ""
                    if os.path.exists(label_path):
                        try:
                            with open(label_path, 'r') as lf:
                                raw_label = lf.read().strip().lower()
                        except IOError:
                            pass
                    SKIP_LABEL_KEYWORDS = ["spd", "dram", "dimm", "ram", "mem", "nvme", "hdd", "ssd", "fan"]
                    if any(kw in raw_label for kw in SKIP_LABEL_KEYWORDS):
                        continue
                    cpu_temp_found = True
                    cpu_driver = driver
                    cpu_temp_value = temp_celsius
                    break
                if cpu_temp_found:
                    break
            if cpu_temp_found:
                break

    if cpu_temp_found:
        print(f"[✓] CPU Thermal sensor found (driver: {cpu_driver}) — {cpu_temp_value:.1f}°C")
        passed += 1
    else:
        print("[✗] No CPU thermal sensor detected")
        failed += 1

    print("\n─── Power Profiles ───────────────────")
    
    # Check platform_profile
    if os.path.exists(PROFILE_PATH) and os.access(PROFILE_PATH, os.R_OK):
        try:
            with open(PROFILE_PATH, 'r') as f:
                current_profile = f.read().strip()
            print(f"[✓] ACPI platform_profile available — current: {current_profile}")
            passed += 1
        except IOError:
            print("[✗] ACPI platform_profile not readable")
            failed += 1
    else:
        print("[✗] ACPI platform_profile not available")
        failed += 1
    
    # Check platform_profile_choices
    if os.path.exists(PROFILE_CHOICES_PATH) and os.access(PROFILE_CHOICES_PATH, os.R_OK):
        try:
            with open(PROFILE_CHOICES_PATH, 'r') as f:
                choices = f.read().strip().split()
            print(f"[✓] Available profiles: {', '.join(choices)}")
            passed += 1
        except IOError:
            print("[✗] platform_profile_choices not readable")
            failed += 1
    else:
        print("[✗] platform_profile_choices not available")
        failed += 1

    print("\n─── GPU Stats ────────────────────────")
    
    # Check nvidia-smi
    if shutil.which('nvidia-smi'):
        print("[✓] nvidia-smi available")
        passed += 1
    else:
        print("[✗] nvidia-smi not found — install nvidia-utils for NVIDIA GPU stats")
        failed += 1

    # Check AMD / Intel DRM hwmon
    drm_hwmon_found = False
    card_dirs = glob.glob("/sys/class/drm/card*/device")
    for card_dir in card_dirs:
        vendor_file = os.path.join(card_dir, "vendor")
        if os.path.exists(vendor_file):
            try:
                with open(vendor_file, 'r') as vf:
                    v_id = vf.read().strip().lower()
                    if v_id == "0x1002":
                        driver_name = get_amd_driver_info(card_dir)
                        print(f"[✓] AMD GPU hwmon found (Driver: {driver_name})")
                        passed += 1
                        drm_hwmon_found = True
                    elif v_id == "0x8086":
                        print("[✓] Intel Graphics (iGPU/Arc) detected")
                        passed += 1
                        drm_hwmon_found = True
            except IOError:
                pass

    if not drm_hwmon_found and not shutil.which('nvidia-smi'):
        print("[✗] No GPU hwmon or tools found — no GPU stats available")
        failed += 1

    print("\n─── Battery ──────────────────────────")
    
    # Check for THE battery
    battery_paths = glob.glob("/sys/class/power_supply/BAT*")
    if battery_paths:
        battery_name = os.path.basename(battery_paths[0])
        print(f"[✓] Battery found: {battery_name}")
        passed += 1

        # Check for charge_control_end_threshold
        charge_control_path = os.path.join(battery_paths[0], "charge_control_end_threshold")
        if os.path.exists(charge_control_path) and os.access(charge_control_path, os.R_OK):
            try:
                with open(charge_control_path, 'r') as f:
                    threshold = f.read().strip()
                print(f"[✓] charge_control_end_threshold available — current: {threshold}")
                passed += 1
            except IOError:
                print("[✗] charge_control_end_threshold not readable")
                failed += 1
        else:
            print("[✗] charge_control_end_threshold not found — battery charge limiting unavailable")
            failed += 1
    else:
        print("[✗] Battery not found")
        failed += 2

    print("\n─── RGB Keyboard ──────────────────────")
    rgb_hint = detect_rgb_hardware()
    if rgb_hint:
        print(f"[✓] RGB control interface detected: {rgb_hint}")
        passed += 1
    else:
        print("[✗] No physical RGB control files found (/sys/devices/platform/hp-wmi/rgb_zones, keyboardleds, etc.)")
        failed += 1

    print(f"\nDoctor complete: {passed} passed, {failed} failed.")

def monitor_stats_loop(render=None, interval=1.5):
    """Redraw `render` (default: the full dashboard) every `interval` seconds."""
    render = render or read_all_stats
    try:
        while True:
            sys.stdout.write(CLEAR_SCREEN)
            sys.stdout.write(HIDE_CURSOR)
            sys.stdout.flush()
            print("=== OpenOMEN Monitor Mode (Ctrl+C to exit) ===")
            print()
            render()
            time.sleep(interval)
    except KeyboardInterrupt:
        pass
    finally:
        print(SHOW_CURSOR, end="", flush=True)
        print("\nExited.")

