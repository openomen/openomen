def _real_user_home():
    """
    Home directory of the user who invoked openomen. Under sudo, '~' resolves to
    /root, so prefer SUDO_USER's home to keep RGB profiles and state in one place.
    """
    sudo_user = os.environ.get("SUDO_USER")
    if check_root() and sudo_user and sudo_user != "root":
        try:
            import pwd
            return pwd.getpwnam(sudo_user).pw_dir
        except (ImportError, KeyError):
            pass
    return os.path.expanduser("~")

def _chown_to_real_user(path):
    """Best effort: hand files created while root over to the invoking user."""
    sudo_user = os.environ.get("SUDO_USER")
    if not (check_root() and sudo_user and sudo_user != "root"):
        return
    try:
        import pwd
        pw = pwd.getpwnam(sudo_user)
        os.chown(path, pw.pw_uid, pw.pw_gid)
    except (ImportError, KeyError, OSError):
        pass

def normalize_hex_color(value):
    """Return a 6-digit uppercase hex string for '#RRGGBB'/'RRGGBB', or None if invalid."""
    if not isinstance(value, str):
        return None
    value = value.strip().lstrip("#")
    if re.fullmatch(r"[0-9a-fA-F]{6}", value):
        return value.upper()
    return None

