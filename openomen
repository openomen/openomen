    fan_subparsers.add_parser('auto', help='Auto/BIOS control')
    fan_subparsers.add_parser('toggle', help='Toggle fan max on/off')
    fan_status_parser = fan_subparsers.add_parser('status', help='Show current fan status')
    fan_status_parser.add_argument('-w', '--watch', action='store_true', help='Refresh every 1.5 seconds (exit with Ctrl+C)')
    cpu_parser = subparsers.add_parser('cpu', help='Read current CPU stats')
    cpu_parser.add_argument('-w', '--watch', action='store_true', help='Refresh every 1.5 seconds (exit with Ctrl+C)')
    gpu_parser = subparsers.add_parser('gpu', help='Read current GPU stats')
    gpu_parser.add_argument('-w', '--watch', action='store_true', help='Refresh every 1.5 seconds (exit with Ctrl+C)')
    stats_parser = subparsers.add_parser('stats', help='Print snapshot of all systems')
    stats_parser.add_argument('-w', '--watch', action='store_true', help='Refresh every 1.5 seconds (exit with Ctrl+C)')
    subparsers.add_parser('info', help='Display diagnostic layout parameters')
    power_parser = subparsers.add_parser('power', help='Manage power configurations')
    power_subparsers = power_parser.add_subparsers(dest='power_command', help='Power commands')
    set_parser = power_subparsers.add_parser('set', help='Set active ACPI power profile')
    set_parser.add_argument('profile', help='Power profile name (e.g. performance, balanced, quiet)')
    apply_parser = power_subparsers.add_parser('apply', help='Apply predefined profile templates')
    apply_parser.add_argument('profile', help='Combined profile name')
    power_subparsers.add_parser('list', help='List available profiles')

    # RGB command
    rgb_parser = subparsers.add_parser('rgb', help='Control keyboard RGB lighting')
    rgb_subparsers = rgb_parser.add_subparsers(dest='rgb_command', help='RGB commands')
    rgb_subparsers.add_parser('status', help='Show current state and active profile')
    rgb_subparsers.add_parser('list', help='List available RGB profiles')
    rgb_set_parser = rgb_subparsers.add_parser('set', help='Set the active RGB profile')
    rgb_set_parser.add_argument('profile', help='Profile name (e.g. rainbow, white, gaming)')
    rgb_subparsers.add_parser('on', help='Turn keyboard lights on')
    rgb_subparsers.add_parser('off', help='Turn keyboard lights off')

    subparsers.add_parser('doctor', help='Check hardware compatibility and driver status')
    
    # Update command with force and verification toggle arguments
    update_parser = subparsers.add_parser('update', help='Update OpenOMEN to the latest version')
    update_parser.add_argument('-f', '--force', action='store_true', help='Force direct update download from releases/latest/download')
    update_parser.add_argument('--no-verify', action='store_false', dest='verify', help='Disable post-download version execution verification')

    parser.add_argument('-v', '--version', action='version', version=f'%(prog)s {VERSION}')

    args = parser.parse_args()
    if not args.command:
        parser.print_help()
        return 1

    if args.command == 'fan':
        if not args.fan_command:
            fan_parser.print_help()
            return 1
        if args.fan_command == 'max':
            return 0 if set_fan_boost_mode('enable') else 1
        elif args.fan_command == 'auto':
            return 0 if set_fan_boost_mode('disable') else 1
        elif args.fan_command == 'toggle':
            return 0 if toggle_fan_boost() else 1
        elif args.fan_command == 'status':
            if args.watch:
                monitor_stats_loop(read_fan_status)
                return 0
            else:
                return 0 if read_fan_status() else 1

    elif args.command == 'cpu':
        if args.watch:
            monitor_stats_loop(read_cpu_stats)
            return 0
        else:
            return 0 if read_cpu_stats() else 1

    elif args.command == 'gpu':
        if args.watch:
            monitor_stats_loop(read_gpu_stats)
            return 0
        else:
            return 0 if read_gpu_stats() else 1

    elif args.command == 'stats':
        if args.watch:
            monitor_stats_loop(read_all_stats)
            return 0
        read_all_stats()
        return 0

    elif args.command == 'info':
        read_system_info()
        return 0

    elif args.command == 'power':
        if not args.power_command:
            power_parser.print_help()
            return 1
        if args.power_command == 'set':
            return 0 if set_power_profile(args.profile) else 1
        elif args.power_command == 'apply':
            return 0 if apply_combined_profile(args.profile) else 1
        elif args.power_command == 'list':
            try:
                with open(PROFILE_CHOICES_PATH, 'r') as f:
                    choices = f.read().strip().split()
                print("ACPI profiles:    " + ", ".join(choices))
                print("Combined profiles: " + ", ".join(COMBINED_PROFILES.keys()))
                return 0
            except IOError as e:
                print(f"Error: {e}", file=sys.stderr)
                return 1

    elif args.command == 'rgb':
        if not args.rgb_command:
            rgb_parser.print_help()
            return 1
        if args.rgb_command == 'status':
            return 0 if rgb_status() else 1
        elif args.rgb_command == 'list':
            return 0 if rgb_list() else 1
        elif args.rgb_command == 'set':
            return 0 if rgb_set(args.profile) else 1
        elif args.rgb_command == 'on':
            return 0 if rgb_power(True) else 1
        elif args.rgb_command == 'off':
            return 0 if rgb_power(False) else 1

    elif args.command == 'doctor':
        # Doctor only reads state, so it runs unprivileged; some checks may be less complete.
        if not check_root():
            print("Note: running without root; some checks may be incomplete (try sudo).\n")
        run_doctor()
        return 0

    elif args.command == 'update':
        return 0 if update_openomen(force=args.force, verify=args.verify) else 1

    return 0

if __name__ == '__main__':
    sys.exit(main())