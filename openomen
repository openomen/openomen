def find_hwmon_path():
    """ Dynamically resolve the hwmon path for hp-wmi """

    base_path = "/sys/devices/platform/hp-wmi/hwmon"

    # Find all hwmon* directories
    hwmon_dirs = glob.glob(f"{base_path}/hwmon*")

    # Look for pwm1_enable in each hwmon directory
    if not hwmon_dirs:
        return None
    for hwmon_dir in hwmon_dirs:
        pwm_enable_path = os.path.join(hwmon_dir, "pwm1_enable")
        if os.path.exists(pwm_enable_path):
            return hwmon_dir
    return None


def read_fan_rpm():
    """
    Read fan RPM values from the hwmon path
    Reads fan1_input and fan2_input if they exist.
    """
    hwmon_path = find_hwmon_path()
    if not hwmon_path:
        return {}
    
    fan_rpm = {}

    # Read fan1_input if it exists
    fan1_path = os.path.join(hwmon_path, "fan1_input")
    if os.path.exists(fan1_path):
        try:
            with open(fan1_path, 'r') as f:
                fan_rpm["fan1"] = int(f.read().strip())
        except (IOError, ValueError):
            pass

    # Read fan2_input if it exists
    fan2_path = os.path.join(hwmon_path, "fan2_input")
    if os.path.exists(fan2_path):
        try:
            with open(fan2_path, 'r') as f:
                fan_rpm["fan2"] = int(f.read().strip())
        except (IOError, ValueError):
            pass
    return fan_rpm


def read_fan_status():
    """ this just display current fan status and RPM information """

    # Get fan status
    fan_status = read_fan_boost_status()
    if fan_status == "0":
        print("Fan Status:       Max (Manual control)")
    elif fan_status == "2":
        print("Fan Status:       Auto (BIOS control)")
    else:
        print("Fan Status:       Unknown")
    
    # Get fan RPM
    fan_rpm = read_fan_rpm()
    if "fan1" in fan_rpm:
        print(f"Fan 1 RPM:        {fan_rpm['fan1']} RPM")
    if "fan2" in fan_rpm:
        print(f"Fan 2 RPM:        {fan_rpm['fan2']} RPM")
    return fan_status is not None


def check_root():
    return os.geteuid() == 0

def ensure_root():
    if not check_root():
        import sys
        # PyInstaller sets sys.executable to the actual binary path
        script_path = sys.executable if getattr(sys, 'frozen', False) else os.path.abspath(sys.argv[0])
        args = ['sudo', script_path] + sys.argv[1:]
        os.execvp('sudo', args)

def read_fan_boost_status():
    """ reads it from pwm1_enable file earlier """

    hwmon_path = find_hwmon_path()
    if not hwmon_path:
        return None
    pwm_enable_path = os.path.join(hwmon_path, "pwm1_enable")
    try:
        with open(pwm_enable_path, 'r') as f:
            return f.read().strip()
    except IOError as e:
        print(f"Error: Failed to read pwm1_enable: {e}", file=sys.stderr)
        return None


def set_fan_boost_mode(mode):
    """ Set fan control mode to either enabled or disabled """
    ensure_root()
    hwmon_path = find_hwmon_path()
    if not hwmon_path:
        print("Error: Could not find hp-wmi hwmon device.", file=sys.stderr)
        print("Make sure the hp-wmi kernel module is loaded.", file=sys.stderr)
        return False
    
    pwm_enable_path = os.path.join(hwmon_path, "pwm1_enable")
    
    try:
        with open(pwm_enable_path, 'w') as f:
            if mode == 'enable':
                f.write('0')
                expected_value = '0'
                print("Max RPM mode enabled, your fan(s) will now run at max RPM speeds.")
            elif mode == 'disable':
                f.write('2')
                expected_value = '2'
                print("Auto mode enabled, your fan(s) will now run at automatic speeds and are controlled by the BIOS again.")
            else:
                print("Error: Invalid mode. Use 'enable' or 'disable'.", file=sys.stderr)
                return False
        
        # Verify the write actually stuck by reading back the value
        time.sleep(0.1)  # Small delay for sanity check!!
        actual_value = read_fan_boost_status()
        
        if actual_value != expected_value:
            print(f"Error: pwm1_enable write failed to stick!", file=sys.stderr)
            print(f"Expected: {expected_value}, Actual: {actual_value}", file=sys.stderr)
            print("This may indicate a hardware/firmware issue or blocked access.", file=sys.stderr)
            print("Try checking if any other daemon is managing fan control.", file=sys.stderr)
            return False
        
        return True
    except PermissionError:
        print("Error: Permission denied writing to pwm1_enable.", file=sys.stderr)
        print("Make sure you're running with sudo.", file=sys.stderr)
        return False
    except IOError as e:
        print(f"Error: Failed to write to pwm1_enable: {e}", file=sys.stderr)
        return False


def toggle_fan_boost():
    """ Toggle fan control between enabled and disabled states. """
    current_status = read_fan_boost_status()
    if current_status is None:
        print("Error: Could not read current fan control status.", file=sys.stderr)
        return False
    
    if current_status == "2":
        # Currently disabled, enable it
        return set_fan_boost_mode('enable')
    elif current_status == "0":
        # Currently enabled, disable it
        return set_fan_boost_mode('disable')
    else:
        print(f"Error: Unknown fan control status: {current_status}", file=sys.stderr)
        return False


def get_friendly_label(label):
    """ Convert technical hwmon labels to userfriendly names, better for everyone """
    label_mapping = {
        'edge': 'CPU',
        'Tccd1': 'CPU CCD1',
        'Tccd2': 'CPU CCD2',
        'Tctl': 'CPU Control',
        'Tdie': 'CPU Die',
        'Package id 0': 'CPU Package',
        'Composite': 'CPU Composite',
        'temp1': 'System',
        'temp2': 'CPU',
        'temp3': 'GPU',
    }
    
    # Return mapped label or original if not found
    return label_mapping.get(label, label)


# Proper temperature reading function
def read_temperature():
    """
    Read temperature from the hwmon device
    Searches all hwmon devices for temperature sensors,
    prioritizing CPU temps over RAM and or other sensors
    """
    hwmon_base = "/sys/class/hwmon"
    hwmon_dirs = glob.glob(f"{hwmon_base}/hwmon*")
    
    if not hwmon_dirs:
        print("Error: No hwmon devices found.", file=sys.stderr)
        return False

    # Driver names associated with CPU temperatures
    CPU_DRIVER_PRIORITY = [
        "coretemp",    # Intel per-core temps
        "k10temp",     # AMD CPU temps
        "zenpower",    # AMD Zen alternative driver
        "hp-wmi",      # HP-specific WMI sensors (BIOS/board)
        "acpitz",      # ACPI thermal zones (fallback)
    ]

    # Label substrings that strongly indicate CPU/package temps
    CPU_LABEL_KEYWORDS = [
        "package", "tctl", "tdie", "core", "cpu", "physical"
    ]

    # Sensors to explicitly skip
    SKIP_LABEL_KEYWORDS = [
        "spd", "dram", "dimm", "ram", "mem", "nvme", "hdd", "ssd", "fan"
    ]

    def get_hwmon_driver(hwmon_dir):
        name_path = os.path.join(hwmon_dir, "name")
        if os.path.exists(name_path):
            try:
                with open(name_path, 'r') as f:
                    return f.read().strip().lower()
            except IOError:
                pass
        return ""

    def read_hwmon_temps(hwmon_dir):
        """Return list of (label, temp_celsius) from a hwmon dir."""
        results = []
        for temp_file in sorted(glob.glob(os.path.join(hwmon_dir, "temp*_input"))):
            try:
                with open(temp_file, 'r') as f:
                    temp_celsius = int(f.read().strip()) / 1000.0

                label_path = temp_file.replace("_input", "_label")
                raw_label = ""
                if os.path.exists(label_path):
                    try:
                        with open(label_path, 'r') as lf:
                            raw_label = lf.read().strip().lower()
                    except IOError:
                        pass

                results.append((raw_label, temp_celsius))
            except IOError:
                continue
        return results

    # To build a map of driver_name (hwmon_dir, [(label, temp), ...])
    hwmon_by_driver = {}
    for hwmon_dir in hwmon_dirs:
        driver = get_hwmon_driver(hwmon_dir)
        temps = read_hwmon_temps(hwmon_dir)
        if temps:
            hwmon_by_driver.setdefault(driver, []).append((hwmon_dir, temps))

    # Go through drivers in priority order, then fall back to everything else
    ordered_drivers = CPU_DRIVER_PRIORITY + [
        d for d in hwmon_by_driver if d not in CPU_DRIVER_PRIORITY
    ]

    for driver in ordered_drivers:
        if driver not in hwmon_by_driver:
            continue

        for hwmon_dir, temps in hwmon_by_driver[driver]:
            for raw_label, temp_celsius in temps:
                # Skip known non-CPU sensors
                if any(kw in raw_label for kw in SKIP_LABEL_KEYWORDS):
                    continue

                # Within a CPU driver, prefer package/core labels
                if driver in CPU_DRIVER_PRIORITY[:3]:  # coretemp / k10temp / zenpower
                    if not any(kw in raw_label for kw in CPU_LABEL_KEYWORDS):
                        continue  # skip non-package entries on first pass

                friendly_label = get_friendly_label(raw_label) if raw_label else driver
                label = friendly_label + ": " if friendly_label else ""
                print(f"{label}Temperature: {temp_celsius:.1f}°C")
                return True

    # Second pass: relax the label filter for CPU drivers (e.g. unlabelled coretemp entries)
    for driver in CPU_DRIVER_PRIORITY:
        if driver not in hwmon_by_driver:
            continue
        for hwmon_dir, temps in hwmon_by_driver[driver]:
            for raw_label, temp_celsius in temps:
                if any(kw in raw_label for kw in SKIP_LABEL_KEYWORDS):
                    continue
                friendly_label = get_friendly_label(raw_label) if raw_label else driver
                label = friendly_label + ": " if friendly_label else ""
                print(f"{label}Temperature: {temp_celsius:.1f}°C")
                return True

    print("Error: No CPU temperature sensor found in any hwmon device.", file=sys.stderr)
    return False

def read_cpu_stats():
    """
    Read CPU temperature, utilization per core and frequency.
    """
    cpu_name = "Unknown CPU"
    try:
        with open("/proc/cpuinfo", "r") as f:
            for line in f:
                if line.startswith("model name"):
                    cpu_name = line.split(":", 1)[1].strip()
                    break
    except IOError:
        pass
    print(f"CPU:              {cpu_name}\n")

    # Temperature
    read_temperature()

    # Per-core usage & frequency
    try:
        # Two reads 500ms apart to get a real usage
        with open("/proc/stat", "r") as f:
            lines1 = f.readlines()
        time.sleep(0.5)
        with open("/proc/stat", "r") as f:
            lines2 = f.readlines()

        core_lines1 = [l for l in lines1 if l.startswith("cpu") and l[3] != " "]
        core_lines2 = [l for l in lines2 if l.startswith("cpu") and l[3] != " "]

        freq_paths = sorted(glob.glob(
            "/sys/devices/system/cpu/cpu*/cpufreq/scaling_cur_freq"
        ))

        print()  # just an blank line before core table
        for i, (l1, l2) in enumerate(zip(core_lines1, core_lines2)):
            vals1 = list(map(int, l1.split()[1:]))
            vals2 = list(map(int, l2.split()[1:]))

            idle1, total1 = vals1[3], sum(vals1)
            idle2, total2 = vals2[3], sum(vals2)

            total_delta = total2 - total1
            idle_delta  = idle2  - idle1
            usage = 0.0 if total_delta == 0 else (1 - idle_delta / total_delta) * 100

            freq_mhz = ""
            if i < len(freq_paths):
                try:
                    with open(freq_paths[i], "r") as f:
                        freq_mhz = f"  {int(f.read().strip()) / 1000:.0f} MHz"
                except IOError:
                    pass

            bar_len = 20
            filled  = int(usage / 100 * bar_len)
            bar     = "█" * filled + "░" * (bar_len - filled)
            print(f"  Core {i:<2}  [{bar}] {usage:5.1f}%{freq_mhz}")

    except KeyboardInterrupt:
        print("\nCPU stats reading cancelled by user.")
        return False
    except IOError as e:
        print(f"Error reading CPU stats: {e}", file=sys.stderr)
        return False

    return True

def get_amd_driver_info(card_device_dir):
    """ Helper to detect active AMD GPU Driver (amdgpu, radeon, fglrx/catalyst) """
    driver_link = os.path.join(card_device_dir, "driver")
    if os.path.exists(driver_link):
        try:
            driver_name = os.path.basename(os.readlink(driver_link))
            if driver_name in ["amdgpu", "radeon", "fglrx"]:
                return driver_name
        except OSError:
            pass
    # Fallback module scan
    try:
        with open("/proc/modules", "r") as f:
            modules = f.read()
            for drv in ["amdgpu", "radeon", "fglrx"]:
                if drv in modules:
                    return drv
    except IOError:
        pass
    return "AMD Kernel Driver"

def read_gpu_stats():
    """
    Read GPU temperature, utilization, and specs across multi-GPU setups.
    Supports NVIDIA (nvidia-smi), AMD (sysfs/drm), and Intel (sysfs/drm/iGPU/Arc).
    """
    gpus_found = 0

    # --- 1. NVIDIA GPU Detection & Stats ---
    try:
        result = subprocess.run(
            [
                "nvidia-smi",
                "--query-gpu=name,temperature.gpu,utilization.gpu,memory.used,memory.total,power.draw",
                "--format=csv,noheader,nounits"
            ],
            capture_output=True, text=True, timeout=5
        )
        if result.returncode == 0 and result.stdout.strip():
            lines = result.stdout.strip().split("\n")
            for idx, line in enumerate(lines):
                parts = [p.strip() for p in line.split(",")]
                if len(parts) >= 5:
                    gpu_name, temp, util, vram_used, vram_total = parts[:5]
                    power = parts[5] if len(parts) > 5 else "N/A"
                    gpus_found += 1
                    print(f"GPU {gpus_found} (NVIDIA):    {gpu_name}")
                    print(f"  Temperature:    {temp}°C")
                    print(f"  Utilization:    {util}%")
                    print(f"  VRAM:           {vram_used} / {vram_total} MiB")
                    print(f"  Power Draw:     {power} W\n")
    except KeyboardInterrupt:
        print("\nGPU stats reading cancelled by user.")
        return False
    except (FileNotFoundError, subprocess.TimeoutExpired):
        pass

    # --- 2. AMD & Intel DRM GPU Detection & Stats ---
    try:
        card_dirs = sorted(glob.glob("/sys/class/drm/card[0-9]*/device"))
        for card_dir in card_dirs:
            vendor_file = os.path.join(card_dir, "vendor")
            if not os.path.exists(vendor_file):
                continue
            
            with open(vendor_file, 'r') as f:
                vendor = f.read().strip().lower()

            # --- AMD GPUs (Vendor ID 0x1002) ---
            if vendor == "0x1002":
                gpus_found += 1
                driver_name = get_amd_driver_info(card_dir)
                print(f"GPU {gpus_found} (AMD):       {driver_name.upper()} Architecture")
                
                # Temperature lookup
                hwmon_temps = glob.glob(os.path.join(card_dir, "hwmon/hwmon*/temp1_input"))
                if hwmon_temps:
                    try:
                        with open(hwmon_temps[0], 'r') as tf:
                            temp = int(tf.read().strip()) / 1000.0
                        print(f"  Temperature:    {temp:.1f}°C")
                    except IOError:
                        pass
                
                # Utilization lookup
                busy_file = os.path.join(card_dir, "gpu_busy_percent")
                if os.path.exists(busy_file):
                    try:
                        with open(busy_file, 'r') as bf:
                            util = bf.read().strip()
                        print(f"  Utilization:    {util}%")
                    except IOError:
                        pass
                print()

            # --- Intel GPUs (Vendor ID 0x8086 - iGPU or Desktop ARC) ---
            elif vendor == "0x8086":
                gpus_found += 1
                gpu_type = "Intel Arc / iGPU"
                print(f"GPU {gpus_found} (Intel):     {gpu_type}")
                
                # Thermal lookup
                hwmon_temps = glob.glob(os.path.join(card_dir, "hwmon/hwmon*/temp1_input"))
                if hwmon_temps:
                    try:
                        with open(hwmon_temps[0], 'r') as tf:
                            temp = int(tf.read().strip()) / 1000.0
                        print(f"  Temperature:    {temp:.1f}°C")
                    except IOError:
                        pass

                # Frequency lookup (i915/xe)
                freq_file = os.path.join(card_dir, "drm/card0/gt_cur_freq_mhz")
                if not os.path.exists(freq_file):
                    freq_file = glob.glob(os.path.join(card_dir, "gt*/freq0/act_freq"))
                    freq_file = freq_file[0] if freq_file else None

                if freq_file and os.path.exists(freq_file):
                    try:
                        with open(freq_file, 'r') as ff:
                            freq = ff.read().strip()
                        print(f"  Frequency:      {freq} MHz")
                    except IOError:
                        pass
                print()

    except KeyboardInterrupt:
        print("\nGPU stats reading cancelled by user.")
        return False
    except IOError as e:
        print(f"Error reading sysfs GPU stats: {e}", file=sys.stderr)

    if gpus_found == 0:
        print("Error: No GPU found (nvidia-smi unavailable, no AMD/Intel hwmon).", file=sys.stderr)
        return False

    return True

