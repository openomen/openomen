    rgb_subparsers.add_parser('off', help='Turn keyboard lights off')

    subparsers.add_parser('doctor', help='Check hardware compatibility and driver status')
    
    # Update command with force and verification toggle arguments
    update_parser = subparsers.add_parser('update', help='Update OpenOMEN to the latest version')
    update_parser.add_argument('-f', '--force', action='store_true', help='Force direct update download from releases/latest/download')
    update_parser.add_argument('--no-verify', action='store_false', dest='verify', help='Disable post-download version execution verification')

    parser.add_argument('-v', '--version', action='version', version=f'%(prog)s {VERSION}')

    args = parser.parse_args()
    if not args.command:
        parser.print_help()
        return 1

    if args.command == 'fan':
        if not args.fan_command:
            fan_parser.print_help()
            return 1
        if args.fan_command == 'max':
            ensure_root()
            return 0 if set_fan_boost_mode('enable') else 1
        elif args.fan_command == 'auto':
            ensure_root()
            return 0 if set_fan_boost_mode('disable') else 1
        elif args.fan_command == 'toggle':
            ensure_root()
            return 0 if toggle_fan_boost() else 1
        elif args.fan_command == 'status':
            if args.watch:
                monitor_stats_loop()
                return 0
            else:
                return 0 if read_fan_status() else 1

    elif args.command == 'cpu':
        if args.watch:
            monitor_stats_loop()
            return 0
        else:
            return 0 if read_cpu_stats() else 1

    elif args.command == 'gpu':
        if args.watch:
            monitor_stats_loop()
            return 0
        else:
            return 0 if read_gpu_stats() else 1

    elif args.command == 'stats':
