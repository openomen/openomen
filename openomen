        elif args.rgb_command == 'off':
            return 0 if rgb_power(False) else 1

    elif args.command == 'doctor':
        ensure_root()
        run_doctor()
        return 0

    elif args.command == 'update':
        return 0 if update_openomen(force=args.force, verify=args.verify) else 1

    return 0

if __name__ == '__main__':
    sys.exit(main())