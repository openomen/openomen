        return 0

    elif args.command == 'power':
        if not args.power_command:
            power_parser.print_help()
            return 1
        if args.power_command == 'set':
            ensure_root()
            return 0 if set_power_profile(args.profile) else 1
        elif args.power_command == 'apply':
            ensure_root()
            return 0 if apply_combined_profile(args.profile) else 1
        elif args.power_command == 'list':
            try:
                with open(PROFILE_CHOICES_PATH, 'r') as f:
                    choices = f.read().strip().split()
                print("ACPI profiles:    " + ", ".join(choices))
                print("Combined profiles: " + ", ".join(COMBINED_PROFILES.keys()))
                return 0
            except IOError as e:
                print(f"Error: {e}", file=sys.stderr)
                return 1

    elif args.command == 'rgb':
        if not args.rgb_command:
            rgb_parser.print_help()
            return 1
        if args.rgb_command == 'status':
            return 0 if rgb_status() else 1
        elif args.rgb_command == 'list':
